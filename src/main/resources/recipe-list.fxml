<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.cookingnotebook.controller.RecipeController">

    <top>
        <StackPane prefHeight="50">
            <Label text="Cooking Notebook"/>
        </StackPane>
    </top>

    <left>
        <VBox spacing="5" style="-fx-padding: 5;">

            <TextField
                    fx:id="searchField"
                    promptText="Поиск рецептов..."/>

            <ComboBox
                    fx:id="sortComboBox"
                    prefWidth="180"/>

            <ComboBox
                    fx:id="categoryFilterComboBox"
                    promptText="Все категории"
                    prefWidth="180"/>

            <ListView
                    fx:id="recipeList"
                    prefWidth="250"/>

        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="10" style="-fx-padding: 10;">

            <Label
                    fx:id="modeLabel"
                    text="Новый рецепт"/>

            <Label text="Название"/>

            <TextField
                    fx:id="recipeTitleField"
                    promptText="Название рецепта"/>

            <Label text="Описание"/>

            <TextArea
                    fx:id="descriptionArea"
                    prefRowCount="8"
                    promptText="Описание рецепта"/>

            <Label text="Инструкции"/>

            <TextArea
                    fx:id="instructionsArea"
                    prefRowCount="6"
                    promptText="Шаги приготовления"/>

            <HBox spacing="10">
                <VBox spacing="5">
                    <Label text="Время подготовки (мин)"/>
                    <TextField
                            fx:id="preparationTimeField"
                            promptText="Например: 30"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Порции"/>
                    <TextField
                            fx:id="servingsField"
                            promptText="Например: 4"/>
                </VBox>
            </HBox>

            <Label text="Категория"/>
            <ComboBox
                    fx:id="categoryComboBox"
                    prefWidth="220"/>

            <Label
                    text="Ингредиенты"
                    style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <ListView
                    fx:id="ingredientList"
                    prefHeight="100"/>

            <VBox
                    spacing="7"
                    style="-fx-background-color: #eef1f4; -fx-border-color: #b9c1c9; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10;">

                <Label
                        text="↓ Введите новый ингредиент ниже"
                        style="-fx-text-fill: #4d5966; -fx-font-weight: bold;"/>

                <HBox spacing="5">
                <TextField
                        fx:id="ingredientNameField"
                        promptText="Название ингредиента"
                        prefWidth="180"/>
                <TextField
                        fx:id="ingredientQuantityField"
                        promptText="Количество"
                        prefWidth="70"/>
                <TextField
                        fx:id="ingredientUnitField"
                        promptText="Единица"
                        prefWidth="70"/>
                </HBox>

                <HBox spacing="10">
                <Button
                        fx:id="addIngredientButton"
                        text="+ Добавить ингредиент"
                        onAction="#addIngredient"
                        style="-fx-background-color: #1976d2; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 14 8 14;"/>
                <Button
                        text="Сохранить ингредиент"
                        onAction="#updateIngredient"/>
                <Button
                        text="Удалить ингредиент"
                        onAction="#deleteIngredient"/>
                </HBox>
            </VBox>

            <Label text="Фото"/>
            <ImageView
                    fx:id="recipePhotoView"
                    fitWidth="280"
                    fitHeight="180"
                    preserveRatio="true"/>
            <ListView
                    fx:id="photoList"
                    prefHeight="70"/>
            <HBox spacing="10">
                <Button
                        text="Импортировать фото"
                        onAction="#importPhoto"/>
                <Button
                        text="Экспортировать фото"
                        onAction="#exportPhoto"/>
                <Button
                        text="Удалить фото"
                        onAction="#deletePhoto"/>
            </HBox>

            <Label
                    fx:id="createdAtLabel"
                    text="Создан: -"/>

            <Label
                    fx:id="updatedAtLabel"
                    text="Изменён: -"/>

            <HBox spacing="10">

                <Button
                        fx:id="newRecipeButton"
                        text="+ Новый рецепт"
                        onAction="#newRecipe"
                        style="-fx-background-color: #1976d2; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button
                        fx:id="deleteButton"
                        text="Удалить рецепт"
                        onAction="#deleteRecipe"/>

                <Button
                        fx:id="saveButton"
                        text="Сохранить"
                        onAction="#saveRecipe"/>

            </HBox>

        </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <StackPane prefHeight="30">
            <Label text="Ready"/>
        </StackPane>
    </bottom>

</BorderPane>