<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.cookingnotebook.controller.RecipeController">

    <top>
        <StackPane prefHeight="50">
            <Label text="Cooking Notebook"/>
        </StackPane>
    </top>

    <left>
	<ListView
        fx:id="recipeList"
        prefWidth="250"/>
    </left>

    <center>
        <VBox spacing="10" style="-fx-padding: 10;">

            <Label text="Название"/>

            <TextField
                    fx:id="recipeTitleField"
                    promptText="Название рецепта"/>

            <Label text="Описание"/>

            <TextArea
        fx:id="descriptionArea"
        prefRowCount="8"
        promptText="Описание рецепта"/>

            <HBox spacing="10">

                <Button
        fx:id="deleteButton"
        text="Удалить рецепт"
        onAction="#deleteRecipe"/>
				
				<Button
        fx:id="saveButton"
        text="Новый рецепт"
        onAction="#saveRecipe"/>

            </HBox>

        </VBox>
    </center>

    <bottom>
        <StackPane prefHeight="30">
            <Label text="Ready"/>
        </StackPane>
    </bottom>

</BorderPane>